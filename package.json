{
  "name": "drizzle-ext",
  "version": "0.0.0",
  "private": true,
  "description": "A set of utilities and helpers to construct type-safe, complex SQL expressions with Drizzle ORM",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src"
  ],
